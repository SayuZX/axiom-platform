      "id": "server-management",
      "label": "Server Management",
      "fields": [
        {
          "key": "Framework integration",
          "label": "Framework integration",
          "type": "select",
          "default": "Standalone",
          "options": ["Standalone", "QBCore", "ESX", "Qbox"],
          "description": "Optional economy adapter. Standalone does not access any roleplay framework. Missing selected resources are reported; core protection keeps running."
        },
        {
          "key": "Framework money guard",
          "label": "Framework money guard",
          "type": "boolean",
          "default": false,
          "description": "Enable selected framework precommit money guard and balance tracking. Money gain limit zero disables gain rejection."
        },
        {"key": "QBCore resource", "label": "QBCore resource", "type": "text", "default": "qb-core"},
        {"key": "ESX resource", "label": "ESX resource", "type": "text", "default": "es_extended"},
        {"key": "Qbox resource", "label": "Qbox resource", "type": "text", "default": "qbx_core"},
        {
          "key": "Inventory integration",
          "label": "Inventory integration",
          "type": "select",
          "default": "Standalone",
          "options": ["Standalone", "ox_inventory"],
          "description": "Optional inventory authorization adapter, independent of the selected framework. Custom inventories call standalone exports."
        },
        {"key": "Inventory resource", "label": "Inventory resource", "type": "text", "default": "ox_inventory"},
        {
