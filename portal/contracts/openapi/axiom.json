{
  "openapi": "3.1.0",
  "info": {"title": "Axiom Payment API", "version": "3.0.0", "description": "Invoice baru dijadwalkan untuk verifikasi sejak reservasi, termasuk bila respons pembuatan QRIS terputus. Worker memulihkan antrean invoice nonterminal saat mulai. Kedaluwarsa lokal tidak menghentikan verifikasi provider; settlement terverifikasi memulihkan status PAID tanpa menghitung ulang komisi historis. expires_at disajikan dalam ISO 8601 UTC: timestamp tanpa zona dari merchant bridge dibaca sebagai UTC, bukan WIB; offset eksplisit tetap dihormati."},
  "servers": [{"url": "/"}],
  "security": [{"CustomerKey": []}, {"Session": []}],
  "paths": {
    "/create-qris": {"post": {"operationId": "createPayment", "summary": "Create provider-bound QRIS; 2% fee on new invoices", "description": "Fee snapshot at creation: fee_policy percentage_200bps, fee_rate_bps 200, fee_amount floor(amount * 200 / 10000), net_amount amount - fee_amount. No minimum fee; buyer pays amount only. Historical snapshots are never recalculated. API-key calls do not send a password. Cookie-authenticated calls require password step-up and browser origin headers.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["amount"], "properties": {"amount": {"type": "integer", "minimum": 1, "maximum": 10000000}, "password": {"type": "string", "writeOnly": true}}}}}}, "responses": {"200": {"description": "Provider confirmed invoice", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaymentResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"description": "Provider uncertain; if data includes qris_id, inspect that ID before creating another invoice"}}}},
    "/check-payment": {"get": {"operationId": "checkPayment", "parameters": [{"name": "qris_id", "in": "query", "schema": {"type": "string"}}, {"name": "trx_id", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Verified payment status", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"const": true}, "paid": {"type": "boolean"}, "status": {"type": "string", "enum": ["PENDING", "PAID", "EXPIRED"]}, "data": {"$ref": "#/components/schemas/Payment"}}}}}}, "404": {"$ref": "#/components/responses/Error"}, "502": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/api/qr-status/{id}": {
      "get": {
        "operationId": "publicPaymentStatus",
        "summary": "Status pembayaran untuk pembeli",
        "description": "Tautan invoice acak memberi akses publik terbatas. Respons sukses maupun kesalahan hanya menyertakan ID invoice, referensi, total, status, dan masa berlaku. Komisi, neto, identitas akun, payload QR, dan rincian transaksi penyedia tidak disertakan, termasuk setelah lunas. Sesi atau API key tidak memperluas respons publik. Gunakan endpoint terautentikasi /check-payment atau /api/payments/{id} untuk data keuangan pemilik.",
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {
          "200": {
            "description": "Status terverifikasi; tidak ada objek transaction",
            "content": {"application/json": {
              "schema": {"$ref": "#/components/schemas/PublicPaymentStatusResponse"},
              "examples": {
                "pending": {"value": {"success": true, "paid": false, "status": "PENDING", "data": {"qris_id": "example-invoice-01", "trx_id": "AXP-example-reference", "amount": 100000, "status": "PENDING", "expires_at": "2026-10-10T12:15:00Z"}}},
                "paid": {"value": {"success": true, "paid": true, "status": "PAID", "data": {"qris_id": "example-invoice-01", "trx_id": "AXP-example-reference", "amount": 100000, "status": "PAID", "expires_at": "2026-10-10T12:15:00Z"}}}
              }
            }}
          },
          "400": {"$ref": "#/components/responses/PublicPaymentError"},
          "404": {"$ref": "#/components/responses/PublicPaymentError"},
          "502": {"$ref": "#/components/responses/PublicPaymentError"},
          "503": {"$ref": "#/components/responses/PublicPaymentError"}
        }
      }
    },
    "/api/payments": {"get": {"operationId": "listPayments", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["all", "PENDING", "PAID", "EXPIRED"]}}, {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 120}}], "responses": {"200": {"description": "Account-scoped invoice page"}, "401": {"$ref": "#/components/responses/Error"}}}},
    "/api/payments/{id}": {"get": {"operationId": "paymentDetail", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Owner invoice detail"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/wallet": {"get": {"operationId": "wallet", "security": [{"Session": []}], "responses": {"200": {"description": "Available = earned net - requested - processing - paid out", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "object", "properties": {"wallet": {"$ref": "#/components/schemas/Wallet"}}}}}}}}}}},
    "/api/withdrawals": {"get": {"operationId": "listWithdrawals", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}], "responses": {"200": {"description": "Owner withdrawal page"}}}, "post": {"operationId": "requestWithdrawal", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WithdrawalRequest"}}}}, "responses": {"201": {"description": "Reserved once"}, "200": {"description": "Identical request_id replay"}, "409": {"description": "Different replay payload, changed account, or insufficient balance"}}}},
    "/api/admin/withdrawals/{id}/status": {"post": {"operationId": "changeWithdrawalStatus", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["status", "password"], "properties": {"status": {"enum": ["PROCESSING", "PAID", "REJECTED"]}, "password": {"type": "string", "writeOnly": true}, "confirm_transferred": {"type": "boolean"}, "transfer_reference": {"type": "string", "minLength": 5, "maxLength": 120}, "rejection_reason": {"type": "string", "minLength": 5, "maxLength": 500}}}}}}, "responses": {"200": {"description": "Admin session and password verified; PAID needs unique transfer proof"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/telegram/webhook": {"post": {"operationId": "telegramUpdate", "security": [{"TelegramWebhookSecret": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["update_id"], "properties": {"update_id": {"type": "integer", "minimum": 0}, "message": {"type": "object"}, "callback_query": {"type": "object"}}}}}}, "responses": {"200": {"description": "Persisted update_id; repeated update is deduplicated"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/telegram/link": {"post": {"operationId": "startTelegramLink", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/BrowserRequest"}], "responses": {"200": {"description": "Five-minute single-use deep link; not active until web confirmation"}, "503": {"$ref": "#/components/responses/Error"}}}, "delete": {"operationId": "unlinkTelegram", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/BrowserRequest"}], "responses": {"200": {"description": "Old generation callbacks, conversations and pending deliveries invalidated"}}}},
    "/api/support": {"get": {"operationId": "listSupportTickets", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 200}}, {"name": "status", "in": "query", "schema": {"enum": ["all", "OPEN", "WAITING_ADMIN", "WAITING_CUSTOMER", "CLOSED"]}}], "responses": {"200": {"description": "Account-owned tickets, visible last_message/last_message_at/latest_message_id, unread_count. Internal notes never matched for customers."}}}, "post": {"operationId": "createSupportTicket", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/SupportWrite"}, {"type": "object", "required": ["subject"], "properties": {"subject": {"type": "string", "maxLength": 160}}}]}}}}, "responses": {"201": {"description": "Ticket created or identical request_id replayed"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/support/{id}": {"get": {"operationId": "supportHistory", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/Limit"}, {"name": "before", "in": "query", "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "ticket, latest 50 visible messages (oldest first), has_more, last_read_message_id. Message reply_to has authorized context; read_by_other records web reads only. GET never marks read."}}}},
    "/api/support/{id}/messages": {"post": {"operationId": "replySupport", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportWrite"}}}}, "responses": {"201": {"description": "message_id persisted once per actor/request_id; quote must be visible and from same ticket"}, "409": {"description": "Closed ticket or request_id reused with different payload"}}}},
    "/api/support/{id}/read": {"post": {"operationId": "readSupport", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["message_id"], "properties": {"message_id": {"type": "integer", "minimum": 1}}}}}}, "responses": {"200": {"description": "Monotonic message_id read watermark. Caller must only mark messages actually visible."}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/api/admin/support": {"get": {"operationId": "adminSupportTickets", "security": [{"Session": []}], "description": "Admin only. Same search/status/offset/limit and list fields as /api/support, across customers; internal notes visible.", "responses": {"200": {"description": "Admin ticket list"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/admin/support/{id}": {"get": {"operationId": "adminSupportHistory", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/Limit"}, {"name": "before", "in": "query", "schema": {"type": "integer", "minimum": 1}}], "responses": {"200": {"description": "Admin-only history including internal notes; same pagination and watermark fields as customer history"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/admin/support/{id}/messages": {"post": {"operationId": "adminReplySupport", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupportWrite"}}}}, "responses": {"201": {"description": "Admin message or internal note. Internal quotation requires internal=true; never forwarded to customers."}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/admin/support/{id}/read": {"post": {"operationId": "adminReadSupport", "security": [{"Session": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"$ref": "#/components/parameters/BrowserRequest"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["message_id"], "properties": {"message_id": {"type": "integer", "minimum": 1}}}}}}, "responses": {"200": {"description": "Monotonic per-admin read watermark; Telegram receipt is not a read receipt"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/api/policies/{slug}": {"get": {"operationId": "policyDocument", "security": [], "parameters": [{"name": "slug", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "version", "in": "query", "schema": {"type": "string"}}], "responses": {"200": {"description": "Published policy or immutable archive"}, "503": {"description": "Publication withheld; operator facts/review incomplete"}}}}
  },
  "components": {
    "securitySchemes": {"CustomerKey": {"type": "apiKey", "in": "header", "name": "x-api-key"}, "Session": {"type": "apiKey", "in": "cookie", "name": "axiom_session"}, "TelegramWebhookSecret": {"type": "apiKey", "in": "header", "name": "X-Telegram-Bot-Api-Secret-Token"}},
    "parameters": {"Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, "Offset": {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0}}, "BrowserRequest": {"name": "X-Axiom-Request", "in": "header", "required": true, "schema": {"const": "1"}, "description": "Session mutations also require matching Origin and application/json"}},
    "responses": {
      "Error": {"description": "Request rejected; monetary state is not inferred from transport failure", "content": {"application/json": {"schema": {"type": "object", "required": ["success", "message"], "properties": {"success": {"const": false}, "message": {"type": "string"}, "code": {"type": "string"}}}}}},
      "PublicPaymentError": {
        "description": "Status belum dapat diverifikasi. data, bila tersedia, tetap memakai daftar field publik. paid:false bukan konfirmasi pembayaran gagal.",
        "content": {"application/json": {
          "schema": {"type": "object", "additionalProperties": false, "required": ["success", "paid", "status", "message"], "properties": {"success": {"const": false}, "paid": {"const": false}, "status": {"enum": ["PENDING", "PAID", "EXPIRED", "NOT_FOUND"]}, "message": {"type": "string"}, "data": {"$ref": "#/components/schemas/PublicPayment"}}},
          "example": {"success": false, "paid": false, "status": "PENDING", "message": "Status pembayaran belum dapat diverifikasi.", "data": {"qris_id": "example-invoice-01", "trx_id": "AXP-example-reference", "amount": 100000, "status": "PENDING", "expires_at": "2026-10-10T12:15:00Z"}}
        }}
      }
    },
    "schemas": {
      "SupportWrite": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 4000}, "reply_to_id": {"type": ["integer", "null"], "minimum": 1}, "internal": {"type": "boolean", "description": "Admin replies only"}, "request_id": {"type": "string", "format": "uuid", "description": "Optional, scoped to actor; identical replay returns existing result, different payload 409"}, "attachment": {"$ref": "#/components/schemas/Attachment"}}},
      "PublicPayment": {"type": "object", "additionalProperties": false, "required": ["qris_id", "trx_id", "amount", "status", "expires_at"], "properties": {"qris_id": {"type": "string"}, "trx_id": {"type": "string", "description": "Referensi invoice Axiom, bukan ID transaksi penyedia"}, "amount": {"type": "integer", "description": "Total yang dibayar pembeli dalam Rupiah"}, "status": {"enum": ["PENDING", "PAID", "EXPIRED"]}, "expires_at": {"type": "string", "format": "date-time"}}},
      "PublicPaymentStatusResponse": {"type": "object", "additionalProperties": false, "required": ["success", "paid", "status", "data"], "properties": {"success": {"const": true}, "paid": {"type": "boolean"}, "status": {"enum": ["PENDING", "PAID", "EXPIRED"]}, "data": {"$ref": "#/components/schemas/PublicPayment"}}},
      "Payment": {"type": "object", "required": ["qris_id", "trx_id", "amount", "fee_amount", "net_amount", "status"], "properties": {"qris_id": {"type": "string"}, "trx_id": {"type": "string"}, "amount": {"type": "integer"}, "fee_rate_bps": {"type": "integer", "description": "200 for new invoices (2%); historical values preserved, including 0 for fixed_2500"}, "fee_policy": {"type": "string", "description": "percentage_200bps for new invoices; historical policies including fixed_2500 are preserved"}, "fee_amount": {"type": "integer", "description": "Stored snapshot; new invoices use floor(amount * 200 / 10000) Rupiah, no minimum fee. Example amount 100000: fee 2000"}, "net_amount": {"type": "integer", "description": "amount - stored fee_amount; example amount 100000: net 98000. Fee is not added to buyer total"}, "status": {"enum": ["PENDING", "PAID", "EXPIRED"]}, "created_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "qr_url": {"type": "string"}, "qris_string": {"type": "string"}}},
      "PaymentResponse": {"type": "object", "properties": {"success": {"const": true}, "data": {"$ref": "#/components/schemas/Payment"}}},
      "Wallet": {"type": "object", "properties": {"earned_amount": {"type": "integer"}, "reserved_amount": {"type": "integer"}, "requested_amount": {"type": "integer"}, "processing_amount": {"type": "integer"}, "paid_out_amount": {"type": "integer"}, "available_amount": {"type": "integer"}}},
      "WithdrawalRequest": {"type": "object", "required": ["amount", "bank_name", "account_number", "account_holder", "request_id", "expected_customer_id", "password"], "properties": {"amount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "bank_name": {"type": "string", "minLength": 2, "maxLength": 80}, "account_number": {"type": "string", "pattern": "^[0-9]{6,34}$"}, "account_holder": {"type": "string", "minLength": 2, "maxLength": 120}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,100}$"}, "expected_customer_id": {"type": "string"}, "password": {"type": "string", "writeOnly": true}}},
      "Attachment": {"type": "object", "required": ["name", "type", "data"], "properties": {"name": {"type": "string", "maxLength": 120}, "type": {"enum": ["image/png", "image/jpeg", "application/pdf"]}, "data": {"type": "string", "contentEncoding": "base64", "maxLength": 2800000}}, "description": "Decoded maximum 2 MiB; server checks file signature; download-only"}
    }
  }
}
