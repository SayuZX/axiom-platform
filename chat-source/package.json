{
  "name": "axiom-ai-chat",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/checkSdkStyles.mjs",
    "test:providers": "node --test tests/providers.test.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:agent": "node --test tests/agent-runtime.test.mjs",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:files": "node --test tests/files.test.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "tauri": "tauri",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "prepare:desktop": "node scripts/prepareDesktop.mjs",
    "build:desktop": "npm run prepare:desktop && npm run build",
    "test:desktop-runtime": "npm run prepare:desktop && node tests/desktop-runtime-smoke.mjs",
    "test:native": "npm run prepare:desktop && node scripts/desktop.mjs --cargo test --manifest-path src-tauri/Cargo.toml --release --lib -- --nocapture",
    "test:desktop-window": "node tests/desktop-window-smoke.mjs",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0 --port 1420 --strictPort",
    "icons:android": "node scripts/generateAndroidIcons.mjs",
    "android:init": "node scripts/mobile.mjs android init",
    "android:dev": "node scripts/mobile.mjs android dev",
    "android:build": "node scripts/mobile.mjs android build --apk --target aarch64 --debug",
    "ios:init": "node scripts/mobile.mjs ios init",
    "ios:dev": "node scripts/mobile.mjs ios dev",
    "ios:build": "node scripts/mobile.mjs ios build"
  },
  "dependencies": {
    "@openai/apps-sdk-ui": "0.2.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.12",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "urlpattern-polyfill": "10.1.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "lodash": "4.18.1",
    "katex": "0.18.2"
  }
}
